{
  "name": "unihub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.server.json",
    "server": "tsx watch server/index.ts",
    "start": "node server/index.ts",
    "dev:all": "concurrently -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "postinstall": "node scripts/copy-ocr.mjs",
    "predev": "node scripts/copy-ocr.mjs",
    "prebuild": "node scripts/copy-ocr.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@huggingface/transformers": "^4.3.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "d3-force": "^3.0.0",
    "dexie": "^4.0.10",
    "hono": "^4.13.13",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "smtp-server": "^3.19.21",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
